---
import '../styles/global.css';
const {title='Adenphoto — 2T Studio Lab', description='Nhiếp ảnh, sản xuất nội dung và marketing sáng tạo.'} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080808" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="absolute top-0 z-30 w-full border-b border-white/70">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 md:px-10" aria-label="Điều hướng chính">
      <a href={base} class="text-lg font-bold tracking-[-.08em] md:text-2xl">ADENPHOTO<span class="text-gold">.</span><span class="ml-3 hidden align-middle text-[9px] font-medium tracking-[.2em] text-white/60 sm:inline">2T STUDIO LAB</span></a>
      <div class="hidden items-center gap-9 text-[11px] font-semibold uppercase tracking-[.16em] md:flex">
        <a class="hover:text-gold" href={`${base}#du-an`}>Dự án</a><a class="hover:text-gold" href={`${base}#dich-vu`}>Dịch vụ</a><a class="hover:text-gold" href={`${base}#ve-chung-toi`}>Về studio</a><a class="hover:text-gold" href={`${base}#lien-he`}>Liên hệ ↗</a>
      </div>
      <a href={`${base}#lien-he`} class="outline-cta px-3 py-2 text-[10px] uppercase tracking-widest md:hidden">Liên hệ ↗</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="bg-ink px-6 py-8 text-xs text-white/50 md:px-10"><div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 border-t border-white/70 pt-7"><span>© {new Date().getFullYear()} ADENPHOTO — 2T STUDIO LAB</span><span>MADE TO TELL STORIES.</span></div></footer>
</body>
</html>
